      "isDeleted": false,
      "boundElements": null,
      "updated": 1778174328923,
      "link": null,
      "locked": false,
      "text": "Similar Triangles:\nwall_height_on_screen / proj_dist = CELL_SIZE / distance\nSo,\nwall_height_on_screen = proj_dist * CELL_SIZE / distance\n\nFor simplicity we consider proj_dist(distance between \nscreen and eye to be equal to screen size)\nwall_height_on_screen = WINDOW_HEIGHT * CELL_SIZE / distance\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Similar Triangles:\nwall_height_on_screen / proj_dist = CELL_SIZE / distance\nSo,\nwall_height_on_screen = proj_dist * CELL_SIZE / distance\n\nFor simplicity we consider proj_dist(distance between \nscreen and eye to be equal to screen size)\nwall_height_on_screen = WINDOW_HEIGHT * CELL_SIZE / distance\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
