      "updated": 1778177980186,
      "link": null,
      "locked": false,
      "text": "The Vertical Step: Because the wall might\nbe stretched or shrunk based on distance, \nwe calculate.\nstep = TEX_HEIGHT / line_height.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Vertical Step: Because the wall might\nbe stretched or shrunk based on distance, \nwe calculate.\nstep = TEX_HEIGHT / line_height.",
      "autoResize": true,
      "lineHeight": 1.25
    },
